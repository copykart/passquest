---
import { SITE, NAV_LINKS, MAIN_SITE_LINK } from '../site.config';
---

<header class="nav" id="nav">
  <div class="container">
    <a class="brand" href="/" aria-label="PassQuest Blog home">
      <svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
        <path
          d="M64 128C99.3462 128 128 99.3462 128 64C128 28.6538 99.3462 0 64 0C28.6538 0 0 28.6538 0 64C0 99.3462 28.6538 128 64 128Z"
          fill="#7C6AFF"></path>
        <path
          d="M63.998 108C88.2986 108 107.998 88.3008 107.998 64.0002C107.998 39.6997 88.2986 20.0002 63.998 20.0002C39.6975 20.0002 19.998 39.6997 19.998 64.0002C19.998 88.3008 39.6975 108 63.998 108Z"
          fill="url(#pq-mark-nav)"></path>
        <path
          d="M71.999 12.0002L39.999 68.0002H63.999L55.999 116L95.999 52.0002H71.999V12.0002Z"
          fill="#fff"
          stroke="#fff"
          stroke-width="3.16832"
          stroke-linejoin="round"></path>
        <defs>
          <linearGradient
            id="pq-mark-nav"
            x1="19.998"
            y1="20.0002"
            x2="107.998"
            y2="108"
            gradientUnits="userSpaceOnUse">
            <stop stop-color="#7C6AFF"></stop>
            <stop offset="1" stop-color="#3A1FA0"></stop>
          </linearGradient>
        </defs>
      </svg>
      <span>Pass<i>Quest</i></span>
      <span class="brand-badge">Blog</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <span class="nav-spacer"></span>

    <a
      class="nav-visit"
      href={MAIN_SITE_LINK.href}
      target="_blank"
      rel="noopener"
    >
      {MAIN_SITE_LINK.label} <span aria-hidden="true">↗</span>
    </a>

    <button
      class="theme-toggle"
      id="themeToggle"
      type="button"
      aria-label="Switch color theme"
    >
      <svg class="tt-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
          fill="currentColor"></path>
      </svg>
      <svg class="tt-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
        <path
          d="M12 2v2.6M12 19.4V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.6M19.4 12H22M4.2 19.8 6 18M18 6l1.8-1.8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <a
      class="nav-cta"
      href={SITE.playStore}
      target="_blank"
      rel="noopener"
    >
      Get the app <span aria-hidden="true">↓</span>
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      aria-label="Open menu"
      aria-expanded="false"><span></span></button>
  </div>
</header>

<div class="menu-scrim" id="menuScrim"></div>
<div class="mobile-menu" id="mobileMenu">
  {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
  <a class="mm-visit" href={MAIN_SITE_LINK.href} target="_blank" rel="noopener">
    {MAIN_SITE_LINK.label} <span aria-hidden="true">↗</span>
  </a>
  <a class="nav-cta" href={SITE.playStore} target="_blank" rel="noopener">
    Get the app ↓
  </a>
</div>

<script>
  (function () {
    var root = document.documentElement;
    var tgl = document.getElementById('themeToggle');
    function cur() {
      return root.getAttribute('data-theme') || 'dark';
    }
    function set(t: string) {
      root.setAttribute('data-theme', t);
      try {
        localStorage.setItem('pq-theme', t);
      } catch (e) {}
    }
    if (tgl)
      tgl.addEventListener('click', function () {
        set(cur() === 'dark' ? 'light' : 'dark');
      });

    var nav = document.getElementById('nav');
    var footerBrand = document.querySelector('.site-foot .footer-brand');
    function onScroll() {
      if (!nav) return;
      nav.classList.toggle('scrolled', window.scrollY > 12);
      /* on short pages the footer can be taller than the viewport, so its
         own logo ends up sitting directly behind the blurred nav pill —
         a frosted "ghost duplicate" of the same mark. Drop the blur and
         go solid whenever that's about to happen. */
      if (footerBrand) {
        var navH = nav.getBoundingClientRect().height || 70;
        var top = footerBrand.getBoundingClientRect().top;
        nav.classList.toggle('over-footer', top < navH + 20);
      }
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    var mt = document.getElementById('navToggle');
    var mm = document.getElementById('mobileMenu');
    var sc = document.getElementById('menuScrim');
    function menu(open: boolean) {
      if (nav) nav.classList.toggle('open', open);
      if (mm) mm.classList.toggle('show', open);
      if (sc) sc.classList.toggle('show', open);
      if (mt) mt.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    }
    if (mt)
      mt.addEventListener('click', function () {
        menu(!(mm && mm.classList.contains('show')));
      });
    if (sc) sc.addEventListener('click', function () { menu(false); });
    if (mm)
      mm.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { menu(false); });
      });
  })();
</script>
