---
import { SITE } from '../site.config';

interface Props {
  /* narrow, stacked version for the sidebar rail */
  compact?: boolean;
  title?: string;
  description?: string;
}

const {
  compact = false,
  title = "Know exactly when you're ready",
  description = 'PassQuest gives you a predictive live score that updates after every practice session — download free, no card required.',
} = Astro.props;
---

<div class:list={['app-cta', { compact }]}>
  <div class="ac-phone" aria-hidden="true">
    <div class="ac-screen">
      <div class="ac-notch"></div>
      <div class="ac-greet">Good evening</div>
      <div class="ac-ring">
        <div class="ac-ring-num">82<small>%</small></div>
      </div>
      <div class="ac-ring-label">Readiness score</div>
      <div class="ac-skills">
        <span class="ac-skill l" style="--w:88%"></span>
        <span class="ac-skill r" style="--w:74%"></span>
        <span class="ac-skill w" style="--w:61%"></span>
        <span class="ac-skill s" style="--w:70%"></span>
      </div>
      <div class="ac-go">Continue training →</div>
    </div>
  </div>

  <div class="ac-body">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="ac-stores">
      <a
        class:list={['store-btn', 'filled', { small: compact }]}
        href={SITE.playStore}
        target="_blank"
        rel="noopener"
        aria-label="Get PassQuest on Google Play"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M3.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l.1.1 9.3-9.3v-.2L3.7 2.2l-.1.1Z"
            fill="#00C3FF"></path>
          <path
            d="m16.3 15.9-3.2-3.2v-.2l3.2-3.2.1.1 3.8 2.2c1.1.6 1.1 1.6 0 2.2l-3.9 2.1Z"
            fill="#FFD400"></path>
          <path
            d="m16.4 15.8-3.3-3.3-9.4 9.4c.4.4 1 .4 1.7.1l11-6.2"
            fill="#FF3333"></path>
          <path
            d="M16.4 9.2 5.4 3C4.7 2.6 4.1 2.7 3.7 3.1l9.4 9.4 3.3-3.3Z"
            fill="#00D26A"></path>
        </svg>
        <span class="lbl"><small>GET IT ON</small><b>Google Play</b></span>
      </a>
      <a
        class:list={['store-btn', 'outline', { small: compact }]}
        href={`${SITE.mainSite}/#download`}
        target="_blank"
        rel="noopener"
        aria-label="PassQuest coming soon to the App Store"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M16.4 12.7c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.8-1.7 0-3.2 1-4.1 2.5-1.7 3-.4 7.4 1.3 9.9.8 1.2 1.8 2.5 3.1 2.4 1.2-.1 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-3.5ZM14 5.4c.7-.8 1.1-2 1-3.2-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.3Z"
          ></path>
        </svg>
        <span class="lbl"><small>COMING SOON TO</small><b>App Store</b></span>
      </a>
    </div>
  </div>
</div>
