---
import {
  SITE,
  FOOTER_TAGLINE,
  FOOTER_PRODUCT_LINKS,
  FOOTER_LEGAL_LINKS,
  FOOTER_CONTACT_LINKS,
  SOCIAL_LINKS,
} from '../site.config';

const year = new Date().getFullYear();

/* one bespoke icon per platform, matching passquest.app's footer */
const SOCIAL_ICONS: Record<string, string> = {
  TikTok:
    '<path d="M16 3c.3 2.3 1.6 3.9 3.8 4v2.8c-1.4.1-2.7-.3-3.8-1v6.6c0 3.6-2.6 6.1-6 6.1A5.9 5.9 0 0 1 4 21.6a6 6 0 0 0 4.6 2.1c3.4 0 6-2.5 6-6.1V11c1.1.7 2.4 1.1 3.8 1V9.2c-2.2-.1-3.5-1.7-3.8-4H16Z" opacity=".35"/><path d="M15 2h-3v14.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1v-3a5.6 5.6 0 1 0 4.8 5.5V9.4c1.1.7 2.4 1.1 3.8 1V7.6c-2.2-.1-3.5-1.7-3.8-4A4 4 0 0 1 15 3V2Z"/>',
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1"/>',
  LinkedIn:
    '<path d="M6.5 8H3.7v12h2.8V8ZM5.1 3.5A1.6 1.6 0 1 0 5 6.7a1.6 1.6 0 0 0 .1-3.2ZM20.3 20v-6.6c0-3.5-1.9-5.2-4.4-5.2-2 0-2.9 1.1-3.4 1.9V8H9.7v12h2.8v-6.3c0-.3 0-.7.1-.9.3-.7.9-1.4 2-1.4 1.4 0 2 1.1 2 2.7V20h2.7Z"/>',
  X: '<path d="M17.5 3h3.3l-7.2 8.2L22 21h-6.6l-5.2-6.8L4.3 21H1l7.7-8.8L2 3h6.8l4.7 6.2L17.5 3Zm-1.2 16h1.8L7.8 4.9H5.9L16.3 19Z"/>',
  YouTube:
    '<path d="M22 12c0-2.6-.2-3.8-.5-4.4a2.6 2.6 0 0 0-1.8-1.8C18.4 5.5 12 5.5 12 5.5s-6.4 0-7.7.3a2.6 2.6 0 0 0-1.8 1.8C2.2 8.2 2 9.4 2 12s.2 3.8.5 4.4a2.6 2.6 0 0 0 1.8 1.8c1.3.3 7.7.3 7.7.3s6.4 0 7.7-.3a2.6 2.6 0 0 0 1.8-1.8c.3-.6.5-1.8.5-4.4Zm-12 3V9l5 3-5 3Z"/>',
};
---

<footer class="site-foot">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="PassQuest Blog home">
        <svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
          <path
            d="M64 128C99.3462 128 128 99.3462 128 64C128 28.6538 99.3462 0 64 0C28.6538 0 0 28.6538 0 64C0 99.3462 28.6538 128 64 128Z"
            fill="#7C6AFF"></path>
          <path
            d="M63.998 108C88.2986 108 107.998 88.3008 107.998 64.0002C107.998 39.6997 88.2986 20.0002 63.998 20.0002C39.6975 20.0002 19.998 39.6997 19.998 64.0002C19.998 88.3008 39.6975 108 63.998 108Z"
            fill="url(#pq-mark-foot)"></path>
          <path
            d="M71.999 12.0002L39.999 68.0002H63.999L55.999 116L95.999 52.0002H71.999V12.0002Z"
            fill="#fff"
            stroke="#fff"
            stroke-width="3.16832"
            stroke-linejoin="round"></path>
          <defs>
            <linearGradient
              id="pq-mark-foot"
              x1="19.998"
              y1="20.0002"
              x2="107.998"
              y2="108"
              gradientUnits="userSpaceOnUse">
              <stop stop-color="#7C6AFF"></stop>
              <stop offset="1" stop-color="#3A1FA0"></stop>
            </linearGradient>
          </defs>
        </svg>
        <span>Pass<i>Quest</i></span>
      </a>
      <p>{FOOTER_TAGLINE}</p>
      <div class="socials">
        {
          SOCIAL_LINKS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <svg viewBox="0 0 24 24" fill="currentColor" set:html={SOCIAL_ICONS[s.label]} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer-col">
      <h4>Product</h4>
      {
        FOOTER_PRODUCT_LINKS.map((l) => (
          <a
            href={l.href}
            target={'external' in l && l.external ? '_blank' : undefined}
            rel={'external' in l && l.external ? 'noopener' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="footer-col">
      <h4>Legal</h4>
      {FOOTER_LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      {FOOTER_CONTACT_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} PassQuest App · Operated by {SITE.publisher.legalName}</span>
    <div class="ac-stores">
      <a
        class="store-btn small filled"
        href={SITE.playStore}
        target="_blank"
        rel="noopener"
        aria-label="Get PassQuest on Google Play"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M3.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l.1.1 9.3-9.3v-.2L3.7 2.2l-.1.1Z"
            fill="#00C3FF"></path>
          <path
            d="m16.3 15.9-3.2-3.2v-.2l3.2-3.2.1.1 3.8 2.2c1.1.6 1.1 1.6 0 2.2l-3.9 2.1Z"
            fill="#FFD400"></path>
          <path
            d="m16.4 15.8-3.3-3.3-9.4 9.4c.4.4 1 .4 1.7.1l11-6.2"
            fill="#FF3333"></path>
          <path
            d="M16.4 9.2 5.4 3C4.7 2.6 4.1 2.7 3.7 3.1l9.4 9.4 3.3-3.3Z"
            fill="#00D26A"></path>
        </svg>
        <span class="lbl"><small>GET IT ON</small><b>Google Play</b></span>
      </a>
      <a
        class="store-btn small outline"
        href={`${SITE.mainSite}/#download`}
        target="_blank"
        rel="noopener"
        aria-label="PassQuest coming soon to the App Store"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M16.4 12.7c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.8-1.7 0-3.2 1-4.1 2.5-1.7 3-.4 7.4 1.3 9.9.8 1.2 1.8 2.5 3.1 2.4 1.2-.1 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.6-3.5ZM14 5.4c.7-.8 1.1-2 1-3.2-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.3Z"
          ></path>
        </svg>
        <span class="lbl"><small>COMING SOON TO</small><b>App Store</b></span>
      </a>
    </div>
  </div>
</footer>
