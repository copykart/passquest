---
import { SITE, FOOTER_LINKS, SOCIAL_LINKS } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="container">
    <a class="brand" href={`${SITE.mainSite}/`} aria-label="PassQuest home">
      <svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
        <circle cx="64" cy="64" r="64" fill="#7C6AFF"></circle>
        <path d="M72 12 40 68h24l-8 48 40-64H72V12Z" fill="#fff"></path>
      </svg>
      <span>Pass<i>Quest</i></span>
    </a>

    <nav class="foot-links" aria-label="Footer">
      {FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <nav class="foot-social" aria-label="Social">
      {
        SOCIAL_LINKS.map((s) => (
          <a href={s.href} target="_blank" rel="noopener">
            {s.label}
          </a>
        ))
      }
    </nav>

    <span class="foot-copy">
      © {year} PassQuest App · Operated by {SITE.publisher.legalName}
    </span>
  </div>
</footer>
