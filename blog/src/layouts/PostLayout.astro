---
import type { MarkdownHeading } from 'astro';
import type { Post } from '../lib/posts';
import { readingTime } from '../lib/posts';
import {
  SITE,
  categoryName,
  resolveAuthor,
} from '../site.config';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import Faq from '../components/Faq.astro';
import ShareRow from '../components/ShareRow.astro';
import BlogCard from '../components/BlogCard.astro';
import AppCta from '../components/AppCta.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  related: Post[];
}
const { post, headings, related } = Astro.props;
const d = post.data;
const path = `/${post.id}/`;
const url = new URL(path, SITE.url).href;
const author = resolveAuthor(d.author);
const mins = readingTime(post.body);
const ogImage = d.ogImage ?? d.heroImage;
const heroAbs = new URL(d.heroImage, SITE.url).href;
const publishedISO = d.pubDate.toISOString();
const modifiedISO = (d.updatedDate ?? d.pubDate).toISOString();

const blogPosting = {
  '@type': 'BlogPosting',
  '@id': url + '#article',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline: d.title,
  description: d.description,
  image: [heroAbs],
  datePublished: publishedISO,
  dateModified: modifiedISO,
  articleSection: categoryName(d.category),
  author: {
    '@type': 'Organization',
    name: author.name,
    url: author.url ?? SITE.mainSite,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.publisher.name,
    legalName: SITE.publisher.legalName,
    logo: {
      '@type': 'ImageObject',
      url: SITE.publisher.logo,
    },
  },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: SITE.url + '/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryName(d.category),
      item: `${SITE.url}/topic/${d.category}/`,
    },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};

const faqSchema =
  d.faqs.length > 0
    ? {
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.a.replace(/<[^>]+>/g, ''),
          },
        })),
      }
    : null;

const howToSchema = d.howTo
  ? {
      '@type': 'HowTo',
      name: d.howTo.name,
      description: d.howTo.description,
      ...(d.howTo.totalTime ? { totalTime: d.howTo.totalTime } : {}),
      step: d.howTo.steps.map((s) => ({
        '@type': 'HowToStep',
        name: s.name,
        text: s.text,
      })),
    }
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [blogPosting, breadcrumbs, faqSchema, howToSchema].filter(
    Boolean
  ),
};
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={ogImage}
  type="article"
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
>
  <JsonLd slot="head" schema={schema} />

  <main class="post">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Blog</a>
        <span class="sep">/</span>
        <a href={`/topic/${d.category}/`}>{categoryName(d.category)}</a>
        <span class="sep">/</span>
        <span aria-current="page">{d.title}</span>
      </nav>

      <figure class="post-hero">
        <div class="ph-frame">
          <img
            class="ph-img"
            src={d.heroImage}
            alt={d.heroAlt}
            width="1200"
            height="675"
            fetchpriority="high"
          />
          <div class="ph-scrim" aria-hidden="true"></div>
          <div class="ph-overlay">
            <a class="cat-chip" href={`/topic/${d.category}/`}>
              {categoryName(d.category)}
            </a>
            <h1>{d.title}</h1>
          </div>
        </div>
        {
          d.heroCredit && (
            <figcaption>
              Photo by{' '}
              <a href={d.heroCredit.url} target="_blank" rel="noopener">
                {d.heroCredit.name}
              </a>{' '}
              on{' '}
              <a
                href="https://unsplash.com/?utm_source=passquest_blog&utm_medium=referral"
                target="_blank"
                rel="noopener"
              >
                Unsplash
              </a>
            </figcaption>
          )
        }
      </figure>

      <header class="post-header">
        <p class="lede">{d.description}</p>
        <div class="byline">
          <img src={author.avatar} alt={author.name} width="38" height="38" />
          <div>
            <div class="who">{author.name}</div>
            <div class="when">
              <FormattedDate date={d.pubDate} />
              {
                d.updatedDate && (
                  <> · <FormattedDate date={d.updatedDate} prefix="updated" /></>
                )
              }
              · {mins} min read
            </div>
          </div>
        </div>
      </header>

      <div class="post-shell">
        <div>
          <article class="prose">
            <slot />
          </article>

          <Faq faqs={d.faqs} />

          <AppCta />

          <ShareRow title={d.title} path={path} />

          <aside class="author-box">
            <img src={author.avatar} alt={author.name} width="52" height="52" />
            <div>
              <div class="name">{author.name}</div>
              <div class="role">{author.role}</div>
              <p class="bio">{author.bio}</p>
            </div>
          </aside>
        </div>

        <aside class="side-rail">
          <Toc headings={headings} />
          <AppCta compact title="Know when you're ready" description="Free app · live readiness score" />
        </aside>
      </div>

      {
        related.length > 0 && (
          <section class="related">
            <span class="section-label">You might also like</span>
            <div class="post-grid">
              {related.map((p) => (
                <BlogCard post={p} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>
